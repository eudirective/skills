{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privacy and minimisation policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["trust_profile_version", "policy_id", "max_linkability_score", "purpose_profiles"],
  "properties": {
    "trust_profile_version": {"const": "0.1.0"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "max_linkability_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "purpose_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "destination_kind", "action", "default_transform", "allow_direct_identifiers", "max_attempts", "classification_defaults", "field_rules"],
        "properties": {
          "purpose": {"type": "string", "minLength": 1, "maxLength": 120},
          "destination_kind": {"enum": ["local_file", "user_visible", "feedback_service", "external_recipient", "publication"]},
          "action": {"enum": ["analyze", "render", "feedback", "send", "publish"]},
          "default_transform": {"enum": ["drop", "redact", "keep", "presence_only", "date_to_month", "date_to_year", "country_only", "count_only"]},
          "allow_direct_identifiers": {"type": "boolean"},
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
          "classification_defaults": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["classification", "transform"],
              "properties": {
                "classification": {"enum": ["public", "case_fact", "quasi_identifier", "direct_identifier", "sensitive"]},
                "transform": {"enum": ["drop", "redact", "keep", "presence_only", "date_to_month", "date_to_year", "country_only", "count_only"]}
              }
            }
          },
          "field_rules": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field_id", "transform"],
              "properties": {
                "field_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
                "transform": {"enum": ["drop", "redact", "keep", "presence_only", "date_to_month", "date_to_year", "country_only", "count_only"]}
              }
            }
          }
        }
      }
    }
  }
}
