{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected data input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["trust_profile_version", "case_id", "bound_case_revision", "privacy_classification", "fields"],
  "properties": {
    "trust_profile_version": {"const": "0.1.0"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "bound_case_revision": {"type": "integer", "minimum": 0},
    "privacy_classification": {"enum": ["synthetic", "public", "private"]},
    "fields": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "value", "classification", "analysis_required", "risk_tags"],
        "properties": {
          "field_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "value": {},
          "classification": {"enum": ["public", "case_fact", "quasi_identifier", "direct_identifier", "sensitive"]},
          "analysis_required": {"type": "boolean"},
          "risk_tags": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {"enum": ["rare_nationality", "exact_timestamp", "unusual_family", "unique_topology", "precise_procedural_event", "public_searchable_quote", "repeated_pseudonym"]}
          }
        }
      }
    }
  }
}
