{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "mapping_rule": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "model_version": {
      "const": "0.2.0"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "coverage_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "representation_kind": {
            "minLength": 1,
            "type": "string"
          },
          "source_id": {
            "minLength": 1,
            "type": "string"
          },
          "targets": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "support_role": {
                  "enum": [
                    "foundation",
                    "boundary",
                    "operational",
                    "context"
                  ]
                },
                "target_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "target_type": {
                  "enum": [
                    "element",
                    "interaction",
                    "invariant"
                  ]
                }
              },
              "required": [
                "target_type",
                "target_id",
                "support_role"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "verification_scope": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "representation_kind",
          "verification_scope",
          "coverage_tags",
          "targets"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "source_pack_version": {
      "const": "0.6.1"
    },
    "verification_date": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "model_version",
    "source_pack_version",
    "verification_date",
    "mapping_rule",
    "records"
  ],
  "title": "Source support map v0.1",
  "type": "object"
}
