{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consultation dashboard view model 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "request_kind",
    "assessment",
    "validation",
    "progress",
    "sections",
    "caveats",
    "text_fallback"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "request_kind": { "enum": ["applicant_guidance", "source_research", "no_case_assessment"] },
    "assessment": { "$ref": "#/$defs/assessment" },
    "validation": { "$ref": "#/$defs/validation" },
    "progress": { "$ref": "#/$defs/progress" },
    "sections": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/section" }
    },
    "caveats": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 500 }
    },
    "text_fallback": { "type": ["string", "null"] }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "label", "tone", "coverage_claim", "summary"],
      "properties": {
        "status": { "enum": ["reviewed", "partial", "not_verified"] },
        "label": { "type": "string", "maxLength": 80 },
        "tone": { "enum": ["success", "warning", "danger", "neutral"] },
        "coverage_claim": { "enum": ["comprehensive", "partial", "preliminary"] },
        "summary": { "type": "string", "maxLength": 500 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "result_label", "validator", "validator_label", "validator_version", "receipt_sha256", "outstanding_count", "host_release_enforcement"],
      "properties": {
        "result": { "type": "string", "maxLength": 120 },
        "result_label": { "type": "string", "maxLength": 160 },
        "validator": { "type": "string", "maxLength": 120 },
        "validator_label": { "type": "string", "maxLength": 120 },
        "validator_version": { "type": "string", "maxLength": 40 },
        "receipt_sha256": {
          "type": "string",
          "anyOf": [
            { "pattern": "^[a-f0-9]{64}$" },
            { "enum": ["not available"] }
          ]
        },
        "outstanding_count": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "host_release_enforcement": { "const": "unavailable" }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "c27_checks", "issues_declared", "open_validation_items", "source_response", "source_conversation"],
      "properties": {
        "operations": { "$ref": "#/$defs/progress_measure" },
        "c27_checks": { "$ref": "#/$defs/progress_measure" },
        "issues_declared": { "type": "integer", "minimum": 0, "maximum": 100 },
        "open_validation_items": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "source_response": { "$ref": "#/$defs/source_metric" },
        "source_conversation": { "$ref": "#/$defs/source_metric" }
      }
    },
    "progress_measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "total", "scope", "label"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0, "maximum": 500 },
        "total": { "type": "integer", "minimum": 0, "maximum": 500 },
        "scope": { "type": "string", "maxLength": 120 },
        "label": { "type": "string", "maxLength": 120 }
      }
    },
    "source_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count", "sections_count", "provenance"],
      "properties": {
        "status": { "type": "string", "maxLength": 80 },
        "count": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "sections_count": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "provenance": { "enum": ["model-reported", "none"] }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status", "tone", "detail", "missing", "effect", "fields"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "type": ["string", "null"], "maxLength": 300 },
        "tone": { "enum": ["success", "warning", "danger", "neutral"] },
        "detail": { "type": ["string", "null"], "maxLength": 5000 },
        "missing": { "type": ["string", "null"], "maxLength": 5000 },
        "effect": { "type": ["string", "null"], "maxLength": 5000 },
        "fields": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "value": { "type": "string", "maxLength": 5000 }
            }
          }
        }
      }
    }
  }
}
