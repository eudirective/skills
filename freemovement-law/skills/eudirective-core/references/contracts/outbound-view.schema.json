{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimised outbound view v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["trust_profile_version", "outbound_id", "case_id", "bound_case_revision", "policy_id", "policy_sha256", "purpose", "destination_kind", "destination", "action", "max_attempts", "fields", "minimisation_summary", "linkability_score", "residual_risk_flags", "eligible", "limitations"],
  "properties": {
    "trust_profile_version": {"const": "0.1.0"},
    "outbound_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "bound_case_revision": {"type": "integer", "minimum": 0},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 120},
    "destination_kind": {"enum": ["local_file", "user_visible", "feedback_service", "external_recipient", "publication"]},
    "destination": {"type": "string", "minLength": 1, "maxLength": 500},
    "action": {"enum": ["analyze", "render", "feedback", "send", "publish"]},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
    "fields": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "classification", "transform", "value"],
        "properties": {
          "field_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "classification": {"enum": ["public", "case_fact", "quasi_identifier", "direct_identifier", "sensitive"]},
          "transform": {"enum": ["redact", "keep", "presence_only", "date_to_month", "date_to_year", "country_only", "count_only"]},
          "value": {}
        }
      }
    },
    "minimisation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_fields", "kept_fields", "transformed_fields", "dropped_fields"],
      "properties": {
        "input_fields": {"type": "integer", "minimum": 0},
        "kept_fields": {"type": "integer", "minimum": 0},
        "transformed_fields": {"type": "integer", "minimum": 0},
        "dropped_fields": {"type": "integer", "minimum": 0}
      }
    },
    "linkability_score": {"type": "integer", "minimum": 0, "maximum": 1000},
    "residual_risk_flags": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "maxLength": 120}},
    "eligible": {"type": "boolean"},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 500}}
  }
}
