{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invariant catalog v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "invariants"
  ],
  "properties": {
    "model_version": {
      "const": "0.2.0"
    },
    "invariants": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invariant_id",
          "statement",
          "enforcement",
          "severity",
          "related_elements",
          "check_name"
        ],
        "properties": {
          "invariant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "enforcement": {
            "enum": [
              "mechanical",
              "review"
            ]
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "review"
            ]
          },
          "related_elements": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
            }
          },
          "check_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          }
        }
      }
    }
  }
}
