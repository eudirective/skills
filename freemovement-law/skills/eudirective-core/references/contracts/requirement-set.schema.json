{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement set v0.2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "0.2.0"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "area",
          "required_for_full_release"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "area": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "required_for_full_release": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  },
  "required": [
    "contract_version",
    "requirements"
  ]
}
