{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C5c evidence/deadline/authority candidate set v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_version",
    "ruleset_version",
    "contract_version",
    "element_model_version",
    "case_id",
    "bindings",
    "resolution_status",
    "final_c5c_resolution",
    "evidence_assessments",
    "deadline_assessments",
    "route_assessments",
    "unresolved",
    "limitations"
  ],
  "properties": {
    "engine_version": {
      "const": "0.2.0"
    },
    "ruleset_version": {
      "const": "0.2.0"
    },
    "contract_version": {
      "const": "0.2.0"
    },
    "element_model_version": {
      "const": "0.2.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_sha256",
        "regime_candidates_sha256",
        "c5b_sha256",
        "element_bundle_sha256",
        "context_sha256",
        "source_pack_version",
        "source_pack_sha256",
        "core_route_catalog_version",
        "core_route_catalog_sha256",
        "module_bindings"
      ],
      "properties": {
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "regime_candidates_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "c5b_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "element_bundle_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source_pack_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "core_route_catalog_version": {
          "const": "0.1.0"
        },
        "core_route_catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "module_bindings": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_id",
              "module_family",
              "jurisdiction",
              "manifest_sha256",
              "export_sha256"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "module_family": {
                "enum": [
                  "member_state",
                  "applicant_country"
                ]
              },
              "jurisdiction": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "export_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "resolution_status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "final_c5c_resolution": {
      "const": "not_determined"
    },
    "evidence_assessments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "kind",
          "disposition",
          "restriction_claim_state",
          "supplied_freedom_of_proof_state",
          "freedom_of_proof_candidate",
          "basis_refs",
          "source_refs",
          "supporting_rule_refs",
          "rationale_codes",
          "review_required",
          "limitations"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 160
          },
          "kind": {
            "enum": [
              "dependency_freedom_of_proof",
              "proof_restriction_review"
            ]
          },
          "disposition": {
            "enum": [
              "candidate",
              "not_indicated",
              "blocked",
              "unknown"
            ]
          },
          "restriction_claim_state": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "supplied_freedom_of_proof_state": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "freedom_of_proof_candidate": {
            "enum": [
              "candidate",
              "not_indicated",
              "blocked"
            ]
          },
          "basis_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "supporting_rule_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "rationale_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "review_required": {
            "type": "boolean"
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        }
      }
    },
    "deadline_assessments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "deadline_ref",
          "module_id",
          "kind",
          "disposition",
          "calculation_status",
          "calculated_date",
          "trigger_ref",
          "trigger_date",
          "binding_ref",
          "rule_ref",
          "trigger_event_type",
          "trigger_date_source_ref",
          "trigger_date_provenance_kind",
          "timezone_validation",
          "calendar",
          "timezone",
          "operator",
          "amount",
          "suspension_state",
          "extension_state",
          "source_refs",
          "rationale_codes",
          "review_required",
          "detail"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 160
          },
          "deadline_ref": {
            "type": "string",
            "maxLength": 160
          },
          "module_id": {
            "type": "string",
            "maxLength": 160
          },
          "kind": {
            "enum": [
              "legal_deadline",
              "service_standard",
              "escalation_trigger",
              "limitation_or_appeal",
              "appointment_access",
              "other"
            ]
          },
          "disposition": {
            "enum": [
              "candidate",
              "blocked",
              "unknown"
            ]
          },
          "calculation_status": {
            "enum": [
              "exact",
              "candidate_only",
              "blocked"
            ]
          },
          "calculated_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "trigger_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "trigger_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "calendar": {
            "enum": [
              "calendar_days",
              "business_days",
              "months",
              "years",
              "source_defined"
            ]
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "operator": {
            "enum": [
              "date_add_days",
              "date_add_months",
              "business_days",
              "source_defined",
              "unknown"
            ]
          },
          "amount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100000
          },
          "suspension_state": {
            "enum": [
              "none",
              "possible",
              "active",
              "unknown"
            ]
          },
          "extension_state": {
            "enum": [
              "none",
              "possible",
              "active",
              "unknown"
            ]
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "suspension_conditions": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "extension_conditions": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "effect_on_other_remedies": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "rationale_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "review_required": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "binding_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "rule_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "trigger_event_type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "trigger_date_source_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 400
          },
          "trigger_date_provenance_kind": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "timezone_validation": {
            "enum": [
              "not_checked",
              "missing",
              "invalid",
              "valid_iana_date_only"
            ]
          }
        }
      }
    },
    "route_assessments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "route_ref",
          "route_origin",
          "module_id",
          "authority_ref",
          "authority_name",
          "authority_level",
          "target_authority_level_validation",
          "disposition",
          "issue_match",
          "powers",
          "limits",
          "source_refs",
          "legal_basis_refs",
          "verified_at",
          "rationale_codes",
          "review_required",
          "detail"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 160
          },
          "route_ref": {
            "type": "string",
            "maxLength": 160
          },
          "route_origin": {
            "enum": [
              "core",
              "module"
            ]
          },
          "module_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "authority_ref": {
            "type": "string",
            "maxLength": 160
          },
          "authority_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "authority_level": {
            "enum": [
              "eu_institution",
              "eu_body",
              "eu_network",
              "member_state_authority",
              "applicant_country_authority",
              "unknown"
            ]
          },
          "authority_competence": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "disposition": {
            "enum": [
              "candidate",
              "not_indicated",
              "blocked",
              "unknown"
            ]
          },
          "issue_match": {
            "enum": [
              "matched",
              "not_matched",
              "unknown"
            ]
          },
          "powers": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "limits": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "legal_basis_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "rationale_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "review_required": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "target_authority_level_validation": {
            "enum": [
              "matched",
              "mismatched",
              "unknown_frozen_contract",
              "not_checked"
            ]
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "scope",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    }
  }
}
