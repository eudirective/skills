{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C5a topology resolution v0.1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_version",
    "contract_version",
    "element_model_version",
    "case_id",
    "bound_case_sha256",
    "bound_element_bundle_sha256",
    "jurisdiction_registry_version",
    "jurisdiction_registry_sha256",
    "resolution_status",
    "roles",
    "state_roles",
    "input_signals",
    "contexts",
    "module_request_checks",
    "jurisdiction_normalizations",
    "conflicts",
    "unresolved",
    "limitations"
  ],
  "properties": {
    "engine_version": {
      "const": "0.1.1"
    },
    "contract_version": {
      "const": "0.2.0"
    },
    "element_model_version": {
      "const": "0.2.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "bound_case_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bound_element_bundle_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "resolution_status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nationality_state",
        "residence_state",
        "work_state",
        "host_state",
        "intended_residence_state",
        "application_country",
        "deciding_state",
        "representing_state",
        "document_issuing_state",
        "challenged_authority_state"
      ],
      "properties": {
        "nationality_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "residence_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "work_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "host_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "intended_residence_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "application_country": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "deciding_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "representing_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "document_issuing_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "challenged_authority_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "state_roles": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jurisdiction",
          "roles"
        ],
        "properties": {
          "jurisdiction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    "input_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movement_cross_border",
        "free_movement_exercised",
        "frontier_worker_context",
        "returnee_context"
      ],
      "properties": {
        "movement_cross_border": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "free_movement_exercised": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "frontier_worker_context": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "returnee_context": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multi_state",
        "cross_border_work",
        "returnee",
        "representation"
      ],
      "properties": {
        "multi_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "jurisdiction_count",
            "basis_refs"
          ],
          "properties": {
            "status": {
              "enum": [
                "established",
                "not_established"
              ]
            },
            "jurisdiction_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "basis_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "cross_border_work": {
          "$ref": "#/$defs/contextCandidate"
        },
        "returnee": {
          "$ref": "#/$defs/contextCandidate"
        },
        "representation": {
          "$ref": "#/$defs/contextCandidate"
        }
      }
    },
    "module_request_checks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "role",
          "jurisdiction",
          "status",
          "expected_jurisdiction",
          "destination_state"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "status": {
            "enum": [
              "matched",
              "mismatch",
              "unbound"
            ]
          },
          "expected_jurisdiction": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "destination_state": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "role",
          "bound_value",
          "conflicting_value",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "bound_value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "conflicting_value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "field",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "jurisdiction_normalizations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "input",
          "canonical"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "canonical": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "jurisdiction_registry_version": {
      "const": "0.1.0"
    },
    "jurisdiction_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "contextCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_refs",
        "review_required",
        "detail"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "not_indicated",
            "undetermined",
            "present",
            "not_present"
          ]
        },
        "basis_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "review_required": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
