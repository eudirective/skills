{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"C11a/b deterministic, fact-value legal review v0.1.0 (never legal findings)",
  "type":"object", "additionalProperties":false,
  "required":["engine_version","contract_extension","case_id","bindings","conclusion","assessments","unresolved","limitations"],
  "properties":{
    "engine_version":{"const":"0.1.0"},
    "contract_extension":{"const":"c11a-b-0.1.0"},
    "case_id":{"type":"string","minLength":1,"maxLength":160},
    "bindings":{"type":"object","additionalProperties":false,
      "required":["case_sha256","elements_sha256","c5d_sha256","source_pack_sha256","profiles_sha256","module_bindings"],
      "properties":{
        "case_sha256":{"$ref":"#/$defs/sha"},
        "elements_sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},
        "c5d_sha256":{"$ref":"#/$defs/sha"},
        "source_pack_sha256":{"$ref":"#/$defs/sha"},
        "profiles_sha256":{"$ref":"#/$defs/sha"},
        "module_bindings":{"type":"array","maxItems":30,"items":{"type":"object","additionalProperties":false,
          "required":["module_id","module_family","jurisdiction","manifest_sha256","export_sha256"],
          "properties":{"module_id":{"type":"string"},"module_family":{"enum":["member_state","applicant_country"]},"jurisdiction":{"type":"string"},"manifest_sha256":{"$ref":"#/$defs/sha"},"export_sha256":{"$ref":"#/$defs/sha"}}}}
      }
    },
    "conclusion":{"const":"not_determined"},
    "assessments":{"type":"array","maxItems":500,"items":{"$ref":"#/$defs/assessment"}},
    "unresolved":{"type":"array","maxItems":1000,"uniqueItems":true,"items":{"type":"string","maxLength":1500}},
    "limitations":{"type":"array","minItems":1,"maxItems":50,"items":{"type":"string","maxLength":1500}}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "test":{"type":"object","additionalProperties":false,"required":["field","test_result","expected_values"],
       "properties":{"field":{"type":"string","maxLength":160},"test_result":{"enum":["matched","contrary","missing"]},"expected_values":{"type":"array","maxItems":80,"items":{"type":["string","boolean","integer"]}}}},
    "fact":{"type":"object","additionalProperties":false,"required":["field","value","fact_source_ref"],
      "properties":{"field":{"type":"string","maxLength":160},"value":{"type":["string","boolean","integer"]},"fact_source_ref":{"type":["string","null"],"maxLength":160}}},
    "contrary":{"type":"object","additionalProperties":false,"required":["field","value","fact_source_ref","expected_values"],
      "properties":{"field":{"type":"string","maxLength":160},"value":{"type":["string","boolean","integer"]},"fact_source_ref":{"type":["string","null"],"maxLength":160},"expected_values":{"type":"array","maxItems":80,"items":{"type":["string","boolean","integer"]}}}},
    "citation":{"type":"object","additionalProperties":false,"required":["source_id","pinpoint_hint","provenance_level","url"],
      "properties":{"source_id":{"type":"string","maxLength":160},"pinpoint_hint":{"type":"string","maxLength":500},"provenance_level":{"enum":["bundled_in_core","catalogue_metadata_not_reverified_here","official_source_summary_note_only"]},"url":{"type":"string","maxLength":600}}},
    "assessment":{"type":"object","additionalProperties":false,
      "required":["assessment_id","kind","attack_angle_id","label","status","legal_violation_status","upstream_c5d_status","procedure_type","predicate_tests","material_facts","contrary_facts","missing_facts","exceptions_to_review","alternative_evidence_to_review","source_citations","limitations"],
      "properties":{
        "assessment_id":{"type":"string","minLength":1,"maxLength":250},"kind":{"enum":["attack","topic"]},
        "attack_angle_id":{"type":["string","null"],"maxLength":160},"label":{"type":"string","maxLength":500},
        "status":{"enum":["supported_for_review","contradicted","unresolved","not_applicable"]},
        "legal_violation_status":{"const":"not_determined"},
        "upstream_c5d_status":{"enum":["candidate","supported","blocked","insufficient_evidence","not_indicated",null]},
        "procedure_type":{"type":"string","maxLength":160},
        "predicate_tests":{"type":"array","maxItems":40,"items":{"$ref":"#/$defs/test"}},
        "material_facts":{"type":"array","maxItems":40,"items":{"$ref":"#/$defs/fact"}},
        "contrary_facts":{"type":"array","maxItems":40,"items":{"$ref":"#/$defs/contrary"}},
        "missing_facts":{"type":"array","maxItems":80,"uniqueItems":true,"items":{"type":"string","maxLength":1500}},
        "exceptions_to_review":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1500}},
        "alternative_evidence_to_review":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1500}},
        "source_citations":{"type":"array","maxItems":30,"items":{"$ref":"#/$defs/citation"}},
        "limitations":{"type":"array","minItems":1,"maxItems":50,"items":{"type":"string","maxLength":1500}}
      }
    }
  }
}
