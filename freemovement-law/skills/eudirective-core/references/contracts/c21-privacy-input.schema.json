{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C21 privacy fixture input 0.1.0 (synthetic-only execution)",
  "type": "object", "additionalProperties": false,
  "required": ["input_version", "data_class", "case_ref", "fields", "redaction_terms"],
  "properties": {
    "input_version": {"const": "0.1.0"},
    "data_class": {"enum": ["synthetic", "public", "private"]},
    "case_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,60}$"},
    "fields": {"type": "array", "minItems": 1, "maxItems": 200,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["field_id", "classification", "value", "risk_tags"],
        "properties": {
          "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,49}$"},
          "classification": {"enum": ["public", "case_fact", "quasi_identifier", "direct_identifier", "sensitive"]},
          "value": {"oneOf": [{"type": "string", "maxLength": 12000}, {"type": "integer", "minimum": 0, "maximum": 1000000}]},
          "risk_tags": {"type": "array", "uniqueItems": true, "maxItems": 7, "items": {"enum": ["rare_nationality", "exact_timestamp", "unusual_family", "unique_topology", "precise_procedural_event", "public_searchable_quote", "repeated_pseudonym"]}}
        }
      }
    },
    "redaction_terms": {"type": "array", "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["value", "role"],
        "properties": {
          "value": {"type": "string", "minLength": 3, "maxLength": 250},
          "role": {"enum": ["APPLICANT", "EU_CITIZEN", "OFFICIAL", "PLACE", "IDENTIFIER", "OTHER_PERSON", "DATE"]}
        }
      }
    }
  }
}
