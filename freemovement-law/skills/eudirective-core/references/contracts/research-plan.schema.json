{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core research plan 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "research_id", "created_at", "purpose", "mode", "question", "tasks"],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "research_id": { "type": "string", "pattern": "^RCH-[A-Z0-9][A-Z0-9._-]{0,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "purpose": { "enum": ["public_source_research", "source_freshness_review", "synthetic_issue_followup"] },
    "mode": { "enum": ["quick", "case", "deep"] },
    "question": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "synthetic_binding": { "$ref": "#/$defs/synthetic_binding" },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "allOf": [
    {
      "if": { "properties": { "purpose": { "const": "synthetic_issue_followup" } }, "required": ["purpose"] },
      "then": { "required": ["synthetic_binding"] },
      "else": { "not": { "required": ["synthetic_binding"] } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "synthetic_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "issue_index_sha256", "issue_id"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^RUN-C10-L[1-8]$" },
        "issue_index_sha256": { "$ref": "#/$defs/sha256" },
        "issue_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "owner_id", "jurisdiction", "role"],
      "properties": {
        "family": { "enum": ["core_source", "member_state", "applicant_country", "source_library_national"] },
        "owner_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$", "description": "Exact registered pack/module ID; use unregistered:<CC> only when no national pack is registered." },
        "jurisdiction": { "type": "string", "pattern": "^(EU|[A-Z]{2})$" },
        "role": { "enum": ["common_eu", "residence_state", "work_state", "intended_residence_state", "deciding_state", "representing_state", "challenged_authority_state", "document_issuing_state", "application_context", "mission_context", "national_source"] },
        "source_pack_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "export_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "family": { "const": "core_source" } }, "required": ["family"] },
          "then": {
            "required": ["source_pack_sha256"],
            "properties": { "jurisdiction": { "const": "EU" }, "role": { "const": "common_eu" } },
            "not": { "anyOf": [{ "required": ["manifest_sha256"] }, { "required": ["export_sha256"] }] }
          }
        },
        {
          "if": { "properties": { "family": { "const": "member_state" } }, "required": ["family"] },
          "then": {
            "required": ["manifest_sha256", "export_sha256"],
            "properties": { "jurisdiction": { "pattern": "^[A-Z]{2}$" }, "role": { "enum": ["residence_state", "work_state", "intended_residence_state", "deciding_state", "representing_state", "challenged_authority_state", "document_issuing_state"] } },
            "not": { "required": ["source_pack_sha256"] }
          }
        },
        {
          "if": { "properties": { "family": { "const": "applicant_country" } }, "required": ["family"] },
          "then": {
            "required": ["manifest_sha256", "export_sha256"],
            "properties": { "jurisdiction": { "pattern": "^[A-Z]{2}$" }, "role": { "enum": ["application_context", "mission_context"] } },
            "not": { "required": ["source_pack_sha256"] }
          }
        },
        {
          "if": { "properties": { "family": { "const": "source_library_national" } }, "required": ["family"] },
          "then": {
            "properties": { "jurisdiction": { "pattern": "^[A-Z]{2}$" }, "role": { "const": "national_source" } },
            "not": { "anyOf": [{ "required": ["manifest_sha256"] }, { "required": ["export_sha256"] }] },
            "allOf": [
              { "if": { "properties": { "owner_id": { "pattern": "^unregistered:[A-Z]{2}$" } }, "required": ["owner_id"] }, "then": { "not": { "required": ["source_pack_sha256"] } } },
              { "if": { "properties": { "owner_id": { "not": { "pattern": "^unregistered:[A-Z]{2}$" } } }, "required": ["owner_id"] }, "then": { "required": ["source_pack_sha256"] } }
            ]
          }
        }
      ]
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_kind", "question", "owner", "acceptance_criteria"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^RQT-[A-Z0-9][A-Z0-9._-]{0,63}$" },
        "task_kind": { "enum": ["eu_common_law", "member_state_law", "member_state_procedure", "applicant_country_operations", "national_law", "national_procedure", "source_freshness"] },
        "question": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "owner": { "$ref": "#/$defs/owner" },
        "related_source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "element_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      },
      "allOf": [
        { "if": { "properties": { "task_kind": { "const": "eu_common_law" } }, "required": ["task_kind"] }, "then": { "properties": { "owner": { "properties": { "family": { "const": "core_source" } } } } } },
        { "if": { "properties": { "task_kind": { "enum": ["member_state_law", "member_state_procedure"] } }, "required": ["task_kind"] }, "then": { "properties": { "owner": { "properties": { "family": { "const": "member_state" } } } } } },
        { "if": { "properties": { "task_kind": { "const": "applicant_country_operations" } }, "required": ["task_kind"] }, "then": { "properties": { "owner": { "properties": { "family": { "const": "applicant_country" } } } } } },
        { "if": { "properties": { "task_kind": { "enum": ["national_law", "national_procedure"] } }, "required": ["task_kind"] }, "then": { "properties": { "owner": { "properties": { "family": { "const": "source_library_national" } } } } } }
      ]
    }
  }
}
