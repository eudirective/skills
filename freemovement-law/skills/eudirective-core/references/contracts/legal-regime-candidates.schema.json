{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C5a legal-regime candidate set v0.1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_version",
    "ruleset_version",
    "contract_version",
    "element_model_version",
    "case_id",
    "bound_case_sha256",
    "bound_topology_sha256",
    "bound_element_bundle_sha256",
    "bound_actor_context_sha256",
    "actor_scope",
    "source_pack_version",
    "source_pack_sha256",
    "resolution_status",
    "final_applicability",
    "candidates",
    "returnee_review",
    "interactions",
    "unresolved",
    "limitations"
  ],
  "properties": {
    "engine_version": {
      "const": "0.1.2"
    },
    "ruleset_version": {
      "const": "0.1.2"
    },
    "contract_version": {
      "const": "0.2.0"
    },
    "element_model_version": {
      "const": "0.2.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "bound_case_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bound_topology_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bound_element_bundle_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_pack_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source_pack_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resolution_status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "final_applicability": {
      "const": "not_determined"
    },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "returnee_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale_codes",
        "missing_element_ids",
        "source_hint_refs",
        "primary_source_gap",
        "review_required",
        "detail"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "not_indicated",
            "blocked",
            "unknown"
          ]
        },
        "rationale_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "missing_element_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_hint_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "primary_source_gap": {
          "type": "boolean"
        },
        "review_required": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "interactions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interaction_id",
          "status",
          "candidate_element_ids",
          "detail"
        ],
        "properties": {
          "interaction_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "review_required",
              "not_indicated",
              "blocked"
            ]
          },
          "candidate_element_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "scope",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "bound_actor_context_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "applicant_actor_id",
        "union_citizen_actor_id",
        "relationship_kind",
        "review_required",
        "detail"
      ],
      "properties": {
        "status": {
          "enum": [
            "scoped",
            "legacy_unscoped",
            "blocked"
          ]
        },
        "applicant_actor_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "union_citizen_actor_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "relationship_kind": {
          "enum": [
            "self",
            "family_member",
            "unknown"
          ]
        },
        "review_required": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "candidate_kind",
        "disposition",
        "review_required",
        "rationale_codes",
        "dependency_element_ids",
        "missing_element_ids",
        "source_hint_refs",
        "module_role_hints",
        "limitations"
      ],
      "properties": {
        "element_id": {
          "enum": [
            "legal_regime.directive_2004_38",
            "legal_regime.visa_code",
            "legal_regime.schengen",
            "legal_regime.national_procedure"
          ]
        },
        "candidate_kind": {
          "enum": [
            "direct_framework",
            "procedural_framework",
            "national_supplement"
          ]
        },
        "disposition": {
          "enum": [
            "candidate",
            "not_indicated",
            "blocked",
            "unknown"
          ]
        },
        "review_required": {
          "type": "boolean"
        },
        "rationale_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "dependency_element_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "missing_element_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_hint_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "module_role_hints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
