{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C5e suggestion-generation context v0.2 (v0.1 compatible)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_version",
    "case_id",
    "objective",
    "proposals"
  ],
  "properties": {
    "context_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "statement"
      ],
      "properties": {
        "objective_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suggestion_id",
          "candidate_kind",
          "adapted_stratagem_id",
          "original_stratagem_id",
          "applicability",
          "supporting_attack_angle_refs",
          "supporting_route_refs",
          "action_summary",
          "mechanism_summary",
          "assumptions",
          "prerequisites",
          "expected_effect",
          "risks",
          "reversibility",
          "information_value",
          "burden_cost",
          "disclosure_duty_status",
          "disclosure_review_rationale",
          "falsification_required",
          "inaction_or_delay",
          "deadline_waiver_review",
          "requires_new_determination",
          "new_question"
        ],
        "properties": {
          "suggestion_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "maxLength": 160
          },
          "candidate_kind": {
            "enum": [
              "action",
              "direct_action",
              "no_action",
              "analysis_return"
            ]
          },
          "adapted_stratagem_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^adapted:[0-9]{2}$"
          },
          "original_stratagem_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^original:[0-9]{2}$"
          },
          "applicability": {
            "enum": [
              "applicable",
              "non_applicable"
            ]
          },
          "supporting_attack_angle_refs": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "supporting_route_refs": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "action_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "mechanism_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "assumptions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "prerequisites": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "expected_effect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "risks": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "reversibility": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "information_value": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "burden_cost": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "disclosure_duty_status": {
            "enum": [
              "none_known",
              "satisfied",
              "conflict",
              "unknown"
            ]
          },
          "disclosure_review_rationale": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "falsification_required": {
            "type": "boolean"
          },
          "inaction_or_delay": {
            "type": "boolean"
          },
          "deadline_waiver_review": {
            "enum": [
              "clear",
              "risk_present",
              "unknown",
              "not_applicable"
            ]
          },
          "requires_new_determination": {
            "type": "boolean"
          },
          "new_question": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1500
          },
          "baseline_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "direct_compliance",
              "direct_cooperation",
              "request_clarification",
              "waiting",
              null
            ]
          }
        }
      }
    }
  }
}
