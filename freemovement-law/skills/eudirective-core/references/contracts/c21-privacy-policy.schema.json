{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C21 locked purpose-specific minimisation policy 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "policy_id",
    "profiles"
  ],
  "properties": {
    "policy_version": {
      "const": "0.1.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose",
          "fields"
        ],
        "properties": {
          "name": {
            "enum": [
              "internal_review_preview",
              "public_story_preview",
              "feedback_aggregate_preview",
              "c17_feedback_preview"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field_id",
                "transform",
                "necessary_for"
              ],
              "properties": {
                "field_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,49}$"
                },
                "transform": {
                  "enum": [
                    "enum",
                    "year_only",
                    "scrub_text"
                  ]
                },
                "allowed_values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 30,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,59}$"
                  }
                },
                "necessary_for": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    }
  }
}
