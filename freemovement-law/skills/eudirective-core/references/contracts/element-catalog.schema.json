{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Element catalog v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "families",
    "elements"
  ],
  "properties": {
    "model_version": {
      "const": "0.2.0"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "name",
          "definition"
        ],
        "properties": {
          "family_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id",
          "family",
          "definition",
          "value_type",
          "cardinality",
          "allowed_suppliers",
          "provenance_required",
          "absence_effect",
          "consumers"
        ],
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "value_type": {
            "enum": [
              "string",
              "boolean",
              "integer",
              "number",
              "jurisdiction",
              "date",
              "datetime",
              "string_array",
              "object",
              "status"
            ]
          },
          "cardinality": {
            "enum": [
              "one",
              "zero_or_one",
              "one_or_more",
              "zero_or_more"
            ]
          },
          "allowed_suppliers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "core",
                "member_state",
                "applicant_country",
                "case_workspace",
                "deterministic_calculation",
                "model_candidate"
              ]
            }
          },
          "provenance_required": {
            "type": "boolean"
          },
          "absence_effect": {
            "enum": [
              "none",
              "scoped_gap",
              "blocks_dependent_claim",
              "blocks_exact_calculation",
              "blocks_release"
            ]
          },
          "consumers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    }
  }
}
